# macOS generated files
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

# =========================
# Firmware (ESP-IDF)
# =========================
# Ignore the build directory
firmware/build/

# SDK configuration files
# The following MUST remain tracked:
# firmware/sdkconfig
# firmware/sdkconfig.defaults
# firmware/sdkconfig.esp32dev
# firmware/sdkconfig.optimized
# firmware/sdkconfig.original

# Ignore generated/temporary SDK configuration variants
firmware/sdkconfig.old
firmware/sdkconfig.local
firmware/sdkconfig.ci
firmware/sdkconfig.temp

# Ignore PlatformIO artifacts if still present
firmware/.pio/
firmware/.cache/

# Ignore managed components and dependencies
firmware/managed_components/
firmware/dependencies.lock

# Secrets
firmware/include/secrets.h
!firmware/include/secrets.example.h

# =========================
# Xcode / Swift / macOS
# =========================
# Built products
**/Build/
**/DerivedData/
**/Index.noindex/

# Personal settings
**/*.xcuserdata/
**/*.xcuserstate
**/*.xcworkspace/xcuserdata/

# Archives and dSYMs
**/*.xcarchive
**/*.dSYM/
**/*.dSYM.zip

# Swift Package Manager
**/.build/
**/.swiftpm/

# =========================
# Editors / IDEs
# =========================
# VS Code
.vscode/*
!.vscode/extensions.json
# Cursor
.cursor/

# Temporary and log files
*.log
*.swp
*.swo
*~
